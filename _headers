# Cloudflare Pages response headers (applies to Preview and, after approval, Production).
# CSP allows only the hosts this site really uses: Google Fonts, jsDelivr (supabase-js),
# the dedicated Supabase project, and YouTube embeds/IFrame API.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https: blob:; connect-src 'self' https://jurvphonehknrxjpowoe.supabase.co wss://jurvphonehknrxjpowoe.supabase.co https://cdn.jsdelivr.net; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

/admin.html
  Cache-Control: no-store
/admin
  Cache-Control: no-store
/account.html
  Cache-Control: no-store
/account
  Cache-Control: no-store
