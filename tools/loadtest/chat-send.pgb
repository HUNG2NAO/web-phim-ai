\set n random(2, 1000)
\set f random(1, 20)
\set r random(1, 1000000000)
BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claims', '{"sub":"bbbbbbbb-0000-4000-8000-' || lpad(:n::text, 12, '0') || '","role":"authenticated"}', true), set_config('t.f', :f::text, true), set_config('t.r', :r::text, true);
DO $$ BEGIN PERFORM public.send_chat_message('film:phephim:phim-' || current_setting('t.f'), 'Tin tải ' || current_setting('t.r')); EXCEPTION WHEN OTHERS THEN NULL; END $$;
COMMIT;
