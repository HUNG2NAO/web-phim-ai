\set n random(2, 1000)
\set f random(1, 20)
\set e random(1, 10)
BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claims', '{"sub":"bbbbbbbb-0000-4000-8000-' || lpad(:n::text, 12, '0') || '","role":"authenticated"}', true);
SELECT public.get_playback_source((SELECT id FROM public.site_episodes WHERE site_id = 'phimhay' AND film_id = 'phim-' || :f AND episode_no = :e));
COMMIT;
