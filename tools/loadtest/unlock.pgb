\set n random(2, 1000)
\set f random(1, 20)
\set e random(4, 10)
BEGIN;
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claims', '{"sub":"bbbbbbbb-0000-4000-8000-' || lpad(:n::text, 12, '0') || '","role":"authenticated"}', true);
SELECT public.unlock_episode((SELECT id FROM public.site_episodes WHERE site_id = 'khophim' AND film_id = 'phim-' || :f AND episode_no = :e), 'load-' || :n || '-' || :f || '-' || :e);
COMMIT;
